# 复制为 .env 后修改。.env 不入库、不随镜像分发。
# 注意：DB_PASSWORD 会被拼进 postgres:// 连接串，请只用字母和数字。

DB_PASSWORD=请改成强密码

# 应用镜像名，必须与 load-images.sh 导入的一致（版本号与 -amd64 / -arm64 后缀要对上）
APP_IMAGE=yanghe-finance:1.0.0-amd64

HTTP_PORT=8080
TZ=Asia/Shanghai

# 数据与备份在 NAS 上的存放位置（建议放在有快照/冗余的存储卷）
# 凭证图片放在 ${DATA_DIR}/attachments，由 app 容器（uid 10001）写入；
# 首次启动后如上传报 503，执行：sudo chown -R 10001:10001 ./data/attachments
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

TOKEN_TTL=12h
